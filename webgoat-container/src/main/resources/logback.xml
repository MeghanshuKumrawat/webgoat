<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Disable serialized object receiver -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <!-- Disable input stream reads for attacker-controlled data -->
    <jmxConfigurator />

    <!-- Use secure appenders -->
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <!-- Make sure receiver configuration is disabled -->
    <property name="logback.disableObjectInputStreamUsage" value="true"/>
    <property name="logback.receivers.allowed" value="none"/>

    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.boot.devtools" level="WARN"/>
    <logger name="org.owasp" level="DEBUG"/>
    <logger name="org.owasp.webgoat" level="TRACE"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>